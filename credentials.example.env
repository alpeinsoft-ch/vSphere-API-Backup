# Copy to credentials.env and fill in the vSphere/vCenter credentials.
# Do not commit or share credentials.env. It contains a live password.

VSPHERE_SERVER=vcsa.example.local
VSPHERE_PORT=443
VSPHERE_USER=backup-user@example.local
VSPHERE_PASSWORD=CHANGE_ME

# Set true only if the vCenter certificate is trusted by this server.
VSPHERE_SSL_VERIFY=false

# Protected single-VM command target. The interactive selector can still back up
# explicitly selected VMs from the inventory.
VSPHERE_TARGET_VM=CHANGE_ME_VM_NAME

# Optional hardware locks for the protected single-VM path.
# Set a value to 0 to disable that specific hardware check.
VSPHERE_EXPECTED_CPU=0
VSPHERE_EXPECTED_RAM_MB=0
VSPHERE_EXPECTED_DISK_COUNT=0
VSPHERE_EXPECTED_DISK_SIZE_GB=0

# Optional extra identity lock after the first inventory run.
# EXPECTED_INSTANCE_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Backups are written on this server. Default is ./backups.
BACKUP_OUTPUT_DIR=/srv/shares/Backup-f/Backup-system/vSphere-API-Bakup/backups
MIN_FREE_GB=30

# vSphere HttpNfcLease wait and read timeouts.
LEASE_TIMEOUT_SECONDS=300
READ_TIMEOUT_SECONDS=300

# Large Datastore HTTP downloads use byte-progress stall detection.
# Total runtime may be longer; timeout only starts after bytes stop arriving.
DOWNLOAD_STALL_TIMEOUT_SECONDS=3600

# Task timeout for snapshot creation/removal and smaller vSphere tasks.
TASK_TIMEOUT_SECONDS=3600

# Datastore-side VMDK copy progress timeout for powered-on fallback exports.
# Total runtime may be longer; timeout only starts after the percent value stops changing.
DATASTORE_COPY_STALL_TIMEOUT_SECONDS=3600

# Live backups are crash-consistent by default. Set true only if VMware Tools
# quiesced snapshots are known to work reliably for this VM.
LIVE_SNAPSHOT_QUIESCE=false
